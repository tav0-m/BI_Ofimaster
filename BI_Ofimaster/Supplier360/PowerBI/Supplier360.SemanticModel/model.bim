{
  "name": "Supplier360",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "es-CL",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "ControlCarga",
        "columns": [
          {
            "name": "Archivo",
            "dataType": "string",
            "sourceColumn": "Archivo",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "ControlCarga",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(pRutaModelo & \"ControlCarga.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true])",
                "in",
                "    Headers"
              ]
            }
          }
        ]
      },
      {
        "name": "DimFecha",
        "columns": [
          {
            "name": "Fecha",
            "dataType": "dateTime",
            "sourceColumn": "Fecha",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "Anio",
            "dataType": "double",
            "sourceColumn": "Anio",
            "summarizeBy": "none"
          },
          {
            "name": "Mes",
            "dataType": "double",
            "sourceColumn": "Mes",
            "summarizeBy": "none"
          },
          {
            "name": "AnioMes",
