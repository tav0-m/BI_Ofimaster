                "        {\"ElegibleCompras\", each if _ = \"\" then null else Number.FromText(_, \"en-US\"), type number},",
                "        {\"ElegibleFillRate\", each if _ = \"\" then null else Number.FromText(_, \"en-US\"), type number},",
                "        {\"Repartos\", each if _ = \"\" then null else Number.FromText(_, \"en-US\"), type number},",
                "        {\"DescuadreRepartos\", each if _ = \"\" then null else Number.FromText(_, \"en-US\"), type number},",
                "        {\"ProveedorEnMaestro\", each if _ = \"\" then null else Number.FromText(_, \"en-US\"), type number},",
                "        {\"ProductoEnMaestro\", each if _ = \"\" then null else Number.FromText(_, \"en-US\"), type number},",
                "        {\"CantidadEntregadaVista\", each if _ = \"\" then null else Number.FromText(_, \"en-US\"), type number},",
                "        {\"FechaEmbarqueCandidata\", each if _ = \"\" then null else Date.FromText(_, [Format=\"yyyy-MM-dd\", Culture=\"en-US\"]), type date},",
                "        {\"FechaArriboCandidata\", each if _ = \"\" then null else Date.FromText(_, [Format=\"yyyy-MM-dd\", Culture=\"en-US\"]), type date},",
                "        {\"OTIFEvaluable\", each if _ = \"\" then null else Number.FromText(_, \"en-US\"), type number},",
                "        {\"OTIFCumple\", each if _ = \"\" then null else Number.FromText(_, \"en-US\"), type number}",
                "    })",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Posiciones OC",
            "expression": "COUNTROWS(FactOC)",
            "formatString": "#,0.##"
          },
          {
            "name": "OC distintas",
            "expression": "DISTINCTCOUNT(FactOC[OC])",
            "formatString": "#,0.##"
          },
          {
            "name": "Proveedores con OC",
            "expression": "DISTINCTCOUNT(FactOC[ClaveProveedor])",
            "formatString": "#,0.##"
          },
          {
            "name": "Cobertura datos Fill Rate",
            "expression": "DIVIDE(SUM(FactOC[ElegibleFillRate]), SUM(FactOC[ElegibleCompras]))",
            "formatString": "0.0%"
          },
          {
            "name": "Cantidad pedida evaluable",
            "expression": "IF(HASONEVALUE(FactOC[UnidadOC]), SUM(FactOC[CantidadElegible]))",
            "formatString": "#,0.##"
          },
          {
            "name": "Cantidad cubierta",
            "expression": "IF(HASONEVALUE(FactOC[UnidadOC]), SUM(FactOC[CantidadCubierta]))",
            "formatString": "#,0.##"
          },
          {
            "name": "Fill Rate acumulado unidades",
            "expression": "DIVIDE([Cantidad cubierta], [Cantidad pedida evaluable])",
            "formatString": "0.0%"
          },
          {
            "name": "Fill Rate promedio posiciones",
            "expression": "AVERAGEX(FILTER(FactOC, FactOC[ElegibleFillRate] = 1), DIVIDE(FactOC[CantidadCubierta], FactOC[CantidadElegible]))",
            "formatString": "0.0%"
          },
          {
            "name": "Posiciones completas",
            "expression": "COUNTROWS(FILTER(FactOC, FactOC[ElegibleFillRate] = 1 && FactOC[CantidadFaltante] = 0))",
            "formatString": "#,0.##"
          },
          {
            "name": "Porcentaje posiciones completas",
            "expression": "DIVIDE([Posiciones completas], SUM(FactOC[ElegibleFillRate]))",
            "formatString": "0.0%"
          },
          {
            "name": "Valor OC moneda origen",
            "expression": "IF(HASONEVALUE(FactOC[Moneda]), SUM(FactOC[ValorNetoOC]))",
            "formatString": "#,0.##"
          },
          {
            "name": "Valor pendiente moneda origen",
            "expression": "IF(HASONEVALUE(FactRepartos[Moneda]), SUM(FactRepartos[ValorPendienteMonedaOC]))",
            "formatString": "#,0.##"
          },
          {
            "name": "Valor pendiente vencido",
            "expression": "CALCULATE([Valor pendiente moneda origen], FactRepartos[VencidoAlCorte] = 1)",
            "formatString": "#,0.##"
          },
          {
            "name": "Repartos pendientes",
            "expression": "COUNTROWS(FILTER(FactRepartos, FactRepartos[Elegible] = 1 && FactRepartos[CantidadPendienteAbierta] > 0))",
            "formatString": "#,0.##"
          },
          {
            "name": "Repartos vencidos",
            "expression": "COUNTROWS(FILTER(FactRepartos, FactRepartos[Elegible] = 1 && FactRepartos[CantidadPendienteAbierta] > 0 && FactRepartos[VencidoAlCorte] = 1))",
            "formatString": "#,0.##"
          },
          {
            "name": "Maximo atraso dias",
            "expression": "MAXX(FILTER(FactRepartos, FactRepartos[Elegible] = 1 && FactRepartos[CantidadPendienteAbierta] > 0), FactRepartos[DiasAtraso])",
            "formatString": "#,0.##"
          },
          {
            "name": "OTIF repartos",
            "expression": "DIVIDE(SUM(FactRepartos[OTIFCumple]), SUM(FactRepartos[OTIFEvaluable]))",
            "formatString": "0.0%"
          },
          {
            "name": "Repartos evaluables OTIF",
            "expression": "SUM(FactRepartos[OTIFEvaluable])",
            "formatString": "#,0.##"
          },
          {
            "name": "Casos reclamo",
            "expression": "COUNTROWS(FactReclamosNC)",
            "formatString": "#,0.##"
          },
          {
            "name": "Casos con referencia NC",
            "expression": "COUNTROWS(FILTER(FactReclamosNC, NOT ISBLANK(FactReclamosNC[NCReferencia]) && FactReclamosNC[NCReferencia] <> \"\"))",
            "formatString": "#,0.##"
          },
          {
            "name": "Casos sin resolucion informada",
            "expression": "CALCULATE([Casos reclamo], FactReclamosNC[EstadoDocumental] = \"Sin resolucion informada\")",
            "formatString": "#,0.##"
          },
          {
            "name": "Monto reclamado confirmado",
            "expression": "IF(HASONEVALUE(FactReclamosNC[Moneda]) && SELECTEDVALUE(FactReclamosNC[Moneda]) <> \"SIN_CONFIRMAR\", SUM(FactReclamosNC[MontoReclamado]))",
            "formatString": "#,0.##"
          },
          {
            "name": "Monto NC contabilizado",
            "expression": "IF(HASONEVALUE(FactReclamosNC[Moneda]) && SELECTEDVALUE(FactReclamosNC[Moneda]) <> \"SIN_CONFIRMAR\", CALCULATE(SUM(FactReclamosNC[MontoNCContable]), FactReclamosNC[ContabilizadaVerificada] = 1))",
            "formatString": "#,0.##"
          },
          {
            "name": "Fecha corte compras",
            "expression": "MAX(FactOC[FechaCorte])",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "Posiciones sin proveedor maestro",
            "expression": "CALCULATE([Posiciones OC], FactOC[ProveedorEnMaestro] = 0)",
            "formatString": "#,0.##"
          },
          {
            "name": "Posiciones con descuadre",
            "expression": "SUM(FactOC[DescuadreRepartos])",
            "formatString": "#,0.##"
          },
          {
            "name": "Estado OTIF",
            "expression": "\"No evaluable: falta validar historia y promesa\""
          },
          {
            "name": "Estado transito",
            "expression": "\"Sin evidencia de embarque en las fuentes\""
          },
          {
            "name": "Estado NC",
            "expression": "\"Reclamos; referencias NC sin conciliacion contable\""
          }
        ]
      },
